{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/jobs/:id(\\d+)",
      "destination": "/api/jobs?id=:id"
    },
    {
      "source": "/api/companies/:id(\\d+)",
      "destination": "/api/companies?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?path=scrape",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron?path=freshness",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron?path=funding",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron?path=cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
