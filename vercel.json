{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/store.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/jobs/:id(\\d+)",
      "destination": "/api/jobs?id=:id"
    },
    {
      "source": "/api/companies/:id(\\d+)",
      "destination": "/api/companies?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?path=scrape",
      "schedule": "0 6 * * *"
    }
  ]
}
